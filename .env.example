# .env de la raíz del proyecto (junto a docker-compose.yml), que Compose lee
# automáticamente. Copia este fichero a ".env" y ajusta lo que necesites; no
# hace falta tocar backend/.env a mano, el contenedor "app" sincroniza estos
# mismos valores ahí en cada arranque (ver docker/entrypoint.sh).
DB_DATABASE=savepoint
DB_USERNAME=savepoint
DB_PASSWORD=cambia_password

# Puertos publicados en el host. Cambia estos si ya los tienes ocupados;
# el puerto interno de cada contenedor no cambia, así que no hace falta
# tocar nada más (excepto HTTP_PORT/HTTPS_PORT si además cambias los
# "listen" de docker/nginx.conf).
POSTGRES_PORT=5432
REDIS_PORT=6379
HTTP_PORT=8081
HTTPS_PORT=8043
