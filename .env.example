# .env de la raíz del proyecto (junto a docker-compose.yml), que Compose lee
# automáticamente. Este fichero es opcional: si no existe, docker-compose.yml
# y docker/entrypoint.sh ya caen en estos mismos valores por defecto, así que
# "docker compose up" funciona igual sin él. Solo hace falta copiarlo a
# ".env" (ANTES del primer "docker compose up", ver README) si quieres
# cambiar algo — típicamente un puerto ya ocupado o la contraseña de
# Postgres antes de un despliegue real. No hace falta tocar backend/.env a
# mano: el contenedor "app" sincroniza estos mismos valores ahí en cada
# arranque (ver docker/entrypoint.sh).
DB_DATABASE=savepoint
DB_USERNAME=savepoint
DB_PASSWORD=secreto123

# Puertos publicados en el host. Cambia estos si ya los tienes ocupados;
# el puerto interno de cada contenedor no cambia, así que no hace falta
# tocar nada más (excepto HTTP_PORT/HTTPS_PORT si además cambias los
# "listen" de docker/nginx.conf).
POSTGRES_PORT=5432
REDIS_PORT=6379
HTTP_PORT=8081
HTTPS_PORT=8043
