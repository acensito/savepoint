APP_NAME=Savepoint
APP_ENV=local
APP_KEY=
# true en desarrollo (traza completa de errores en pantalla); la plantilla
# de producción real debe llevar false (ver README, sección "Desplegar
# para uso propio").
APP_DEBUG=true
# :8081 porque es el puerto que publica nginx en local (docker-compose.yml);
# se usa para construir URLs fuera de una petición HTTP real, como los
# enlaces de recuperación de contraseña en el log (MAIL_MAILER=log).
APP_URL=http://localhost:8081

# Regionalización
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# Configuración de logs
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos: mismos valores que docker-compose.yml usa por defecto para
# el contenedor "postgres" (host/puerto/nombre/usuario no dependen de este
# fichero, no hace falta tocarlos; DB_PASSWORD sí, si vas a hacer un
# despliegue real — ver la sección de puertos más abajo sobre por qué
# cambiarla después de que el volumen ya exista no basta por sí solo).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=savepoint
DB_USERNAME=savepoint
DB_PASSWORD=secreto123

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sesión/caché/colas centralizadas en Redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE se deja sin definir a propósito: con bootstrap/app.php
# confiando en X-Forwarded-* de cualquier origen (trustProxies), la cookie ya
# se marca "Secure" sola en cuanto el proxy inverso delante de nginx manda
# X-Forwarded-Proto: https (ver tests/Feature/SessionCookieSecurityTest.php).
# Ponerla a mano en "true" rompería el acceso por HTTP plano en localhost/LAN.

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Búsqueda externa de CEX para autorrellenar EAN/título/carátula (ver
# config/services.php). Los valores por defecto ya funcionan sin tocar esto.
CEX_ALGOLIA_HOST=search.webuy.io
CEX_ALGOLIA_APP_ID=LNNFEEWZVA
CEX_ALGOLIA_API_KEY=bf79f2b6699e60a18ae330a1248b452c
CEX_ALGOLIA_INDEX=prod_cex_es
CEX_IMAGE_HOSTS=es.static.webuy.com

# IGDB (autocompletar desarrollador/fecha de lanzamiento) ya no se
# configura aquí: cada cuenta se da de alta su Client ID/Secret gratuitos de
# https://dev.twitch.tv/console/apps desde Ajustes (/panel/settings).

# Minutos hasta que caduca un token de la API (Sanctum, ver
# app/Http/Controllers/Api/AuthController.php); 43200 = 30 días por defecto.
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

FILESYSTEM_DISK=local

VITE_APP_NAME="${APP_NAME}"

# Puertos publicados en el host por docker-compose.yml (Laravel no los lee,
# solo Docker Compose). Cambia estos si ya los tienes ocupados. HTTP_PORT es
# el que usa nginx tal cual viene el repo (desarrollo/testeo); HTTPS_PORT es
# para cuando despliegas detrás de un proxy inverso que pone el TLS delante
# (comenta/descomenta la línea correspondiente en el "ports:" de nginx en
# docker-compose.yml — ver README).
POSTGRES_PORT=5432
REDIS_PORT=6379
HTTP_PORT=8081
HTTPS_PORT=8443
