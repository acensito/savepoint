#!/bin/bash
set -euo pipefail

# 1. Buscar archivos PHP que están en el stage (listos para el commit), como
#    array para que un nombre de fichero con espacio no se rompa por
#    word-splitting al pasarlo a pint/git add.
mapfile -t STAGED_FILES < <(git diff --cached --name-only --diff-filter=ACM -- '*.php')

# Si no hay archivos PHP en este commit, salimos y dejamos que continúe
if [ ${#STAGED_FILES[@]} -eq 0 ]; then
    exit 0
fi

echo "Formateando código con Laravel Pint..."

# 2. Ejecutar Pint a través de docker compose (no el nombre del contenedor a
#    pelo: así sigue funcionando aunque cambie el nombre del proyecto/compose).
#    -T evita reservar una pseudo-terminal, que aquí no hace falta y puede
#    fallar en un hook no interactivo. Si el contenedor no está levantado o
#    Pint encuentra un error real, se aborta el commit en vez de seguir
#    como si se hubiera formateado.
if ! docker compose exec -T app ./vendor/bin/pint "${STAGED_FILES[@]}"; then
    echo "Laravel Pint ha fallado (¿está el contenedor 'app' levantado?). Commit abortado." >&2
    exit 1
fi

# 3. Volver a añadir los archivos al stage con su nuevo formato
git add -- "${STAGED_FILES[@]}"

echo "Código formateado correctamente."
