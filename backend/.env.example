APP_NAME=Savepoint
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

# Interfaz y validaciones en español (ver lang/es/); en como fallback porque
# es el idioma de los mensajes internos de Laravel que no se han traducido.
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Postgres del servicio "postgres" en el docker-compose.yml de la raíz del
# proyecto; estos valores coinciden con sus credenciales por defecto, así
# que "docker compose up" funciona sin tocar nada más.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=savepoint
DB_USERNAME=savepoint
DB_PASSWORD=secreto123

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# El contenedor "queue" del docker-compose.yml procesa esta cola con
# `queue:work redis`: con cualquier otro driver los jobs no se ejecutarían.
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

# Búsqueda externa de CEX (webuy.com) para autorrellenar EAN/título/carátula
# al dar de alta un juego que no está en la colección. No es una API oficial:
# reutiliza el índice de Algolia de su propia web con una clave pública de
# solo-búsqueda (ver config/services.php y App\Services\GameLookup\CexGameLookupService).
CEX_ALGOLIA_HOST=search.webuy.io
CEX_ALGOLIA_APP_ID=LNNFEEWZVA
CEX_ALGOLIA_API_KEY=bf79f2b6699e60a18ae330a1248b452c
CEX_ALGOLIA_INDEX=prod_cex_es
CEX_IMAGE_HOSTS=es.static.webuy.com

MEMCACHED_HOST=127.0.0.1

# Servicio "redis" del docker-compose.yml.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
